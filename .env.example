# Set these in a local .env; never commit real values or credentials.
ADROBOT_KEITARO_URL=https://YOUR-TEST-KEITARO.example
ADROBOT_KEITARO_API_KEY=REPLACE_WITH_API_KEY_FROM_ADMIN
ADROBOT_DATABASE_URL=sqlite:///./adrobot.db
ADROBOT_LOG_LEVEL=INFO

# TASK-02: determine these IDs and the offer-flow action type using GET-only
# discovery on YOUR Keitaro instance before enabling any write.

# ADROBOT_CREATE_DOMAIN_ID=123

# ADROBOT_CREATE_GROUP_ID=123

# ADROBOT_CREATE_TRAFFIC_SOURCE_ID=123

# ADROBOT_CREATE_OFFER_ACTION_TYPE=http
# Both gates must be enabled explicitly only after separate live-write approval.
ADROBOT_CREATE_MAPPING_VERIFIED=false
ADROBOT_CREATE_WRITES_ENABLED=false
